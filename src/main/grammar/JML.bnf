{
  parserClass="nl.utwente.jmlplugin.parser.JMLParser"
  parserUtilClass="nl.utwente.jmlplugin.parser.JMLJavaParser"

  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix="JML"
  psiImplClassSuffix="Impl"
  psiPackage="nl.utwente.jmlplugin.psi"
  psiImplPackage="nl.utwente.jmlplugin.psi.impl"

  // JMLTypes extends the generated JMLGrammarTypes with the element and token types created by
  // JMLJavaParser and the lexers; use JMLTypes in code
  elementTypeHolderClass="nl.utwente.jmlplugin.psi.JMLGrammarTypes"
  elementTypeClass="nl.utwente.jmlplugin.psi.JMLElementType"
  tokenTypeClass="nl.utwente.jmlplugin.psi.JMLTokenType"
  // the factories give the types the readable names used in syntax error messages
  elementTypeFactory="nl.utwente.jmlplugin.psi.JMLElementType.create"
  tokenTypeFactory="nl.utwente.jmlplugin.psi.JMLTokenType.create"

  tokens = [
    SIGNALS_ONLY = 'signals_only'

    NOT_SPECIFIED = '\not_specified'
    NOTHING = '\nothing'
    EVERYTHING = '\everything'
    INTO = '\into'

    SPEC_PUBLIC = 'spec_public'
    SPEC_PROTECTED = 'spec_protected'
    NON_NULL = 'non_null'
    NULLABLE_BY_DEFAULT = 'nullable_by_default'
    NON_NULL_BY_DEFAULT = 'non_null_by_default'
    SPEC_PURE = 'spec_pure'
    // the arithmetic modes of OpenJML, for the code and the specifications of a class or method
    CODE_JAVA_MATH = 'code_java_math'
    SPEC_JAVA_MATH = 'spec_java_math'
    CODE_SAFE_MATH = 'code_safe_math'
    SPEC_SAFE_MATH = 'spec_safe_math'
    CODE_BIGINT_MATH = 'code_bigint_math'
    SPEC_BIGINT_MATH = 'spec_bigint_math'
    LOOPINVARIANT = 'loop_invariant'
    LOOP_DECREASES = 'loop_decreases'
    LOOP_WRITES = 'loop_writes'
    LOOP_MODIFIES = 'loop_modifies'
    LOOP_ASSIGNS = 'loop_assigns'
    LOOP_ASSIGNABLE = 'loop_assignable'
    // the keyword of an old clause; OLD is \old, in Java expressions
    OLD_KEYWORD = 'old'
    // the lexer also gives these for the British spellings, such as normal_behaviour
    NORMAL_BEHAVIOR = 'normal_behavior'
    EXCEPTIONAL_BEHAVIOR = 'exceptional_behavior'
    BEHAVIOR = 'behavior'

    IDENT = "regexp:[_$a-zA-Z][_$a-zA-Z0-9]*"

    AT_SIGN = '@'
    SEMICOLON = ';'
    L_PAREN = '('
    R_PAREN = ')'
    DOT = '.'
    COMMA = ','
    COLON = ':'
    STAR = '*'
    L_SQ_BRAC ='['
    R_SQ_BRAC = ']'

    WHITE_SPACE = 'regexp:\s+'

    INFORMAL_DESCRIPTION = "regexp:\(\s*\*([^*]|\*+[^*)])+\*\s*\)"
    LINE_COMMENT = "regexp://([^@\r\n][^\r\n]*)?"
    REST = "regexp:[^@;().,:*\[\]\s]"

  ]

  name("method_spec")="method specification"
  name("method_jml")="method specification"
  name("store_ref_list")="list of references"
  name("store_ref")="name"
  name("store_ref_keyword")="\\nothing, \\everything, \\not_specified"
  name("in_method_spec")="in-method specification"
  name("behavior_header")="behavior"
  name("loop_variant")="decreases clause"
  name("ghost_declaration")="ghost or model declaration"
  name("represents_clause")="represents clause"
  name("in_clause")="in clause"
  name("reads_clause")="reads clause"
  name("old_clause")="old clause"
  name("set_statement")="set statement"
  name("diverges_clause")="diverges clause"
  name("check_statement")="check statement"
  name("show_statement")="show statement"
  name("reachable_statement")="reachable statement"
  name("unreachable_statement")="unreachable statement"
  name("halt_statement")="halt statement"
  name("split_statement")="split statement"
  name("loop_assignable_clause")="loop_writes clause"
}

// root jml element
jml_root ::= jml_specification

jml_specification ::= AT_SIGN+ ((method_jml | class_invariants | modifiers | in_method_spec) AT_SIGN*)?

// specifications above methods; "also" can be on a line of its own, as in "//@ also"
method_jml ::= also? method_spec AT_SIGN* modifiers* | also
// a heavyweight specification case starts with a behavior, such as "public normal_behavior", also without "also"
// before it, as OpenJML allows
method_spec ::= spec_case (AT_SIGN* also spec_case | heavyweight_spec_case)*
private spec_case ::= heavyweight_spec_case | lightweight_spec_case
private heavyweight_spec_case ::= AT_SIGN* behavior_header lightweight_spec_case?
private lightweight_spec_case ::= (requires_clause | AT_SIGN* old_clause)+ spec_body? | spec_body
behavior_header ::= (public | protected | private)? (NORMAL_BEHAVIOR | EXCEPTIONAL_BEHAVIOR | BEHAVIOR)
// as in OpenJML, a requires clause can also come after other clauses, though it usually comes first
spec_body ::= (AT_SIGN* (ensures_clause | signals_clause | signals_only_clause | assignable_clause | diverges_clause
    | reads_clause | old_clause | requires_clause))+

// clauses allowed in method specifications
requires_clause ::= AT_SIGN* (requires|pre) pred_or_not clause_end {pin="pred_or_not"}
ensures_clause ::= (ensures|post) pred_or_not clause_end {pin="pred_or_not"}
signals_clause ::= signals L_PAREN reference_type IDENT? R_PAREN pred_or_not? SEMICOLON+ {pin="pred_or_not"}
// lists may continue on a new line that starts with @-signs, before or after a comma
signals_only_clause ::= SIGNALS_ONLY <<skipAtSigns>> (NOTHING | reference_type (<<skipAtSigns>> COMMA <<skipAtSigns>> reference_type)*) SEMICOLON+
assignable_clause ::= (assignable|modifiable|modifies|assigns) <<skipAtSigns>> store_ref_list SEMICOLON+
// whether the method may not terminate, such as "diverges true;"
diverges_clause ::= diverges pred_or_not clause_end {pin="pred_or_not"}
// the locations that the method may read, such as "reads \nothing;", also spelled accessible
reads_clause ::= (reads | accessible) <<skipAtSigns>> store_ref_list SEMICOLON+
// a variable for the clauses after it in its specification case, with the value of its initializer before the method,
// such as "old int n = size;"
old_clause ::= OLD_KEYWORD modifiers? <<parseGhostDeclarator>> SEMICOLON+ {pin=1}
private pred_or_not ::= NOT_SPECIFIED | java_expr
// the end of a clause with an expression; as in OpenJML, the semicolon may be missing at the end of the JML, which
// the annotators then report as a warning (or an error, when a JML comment follows)
private clause_end ::= SEMICOLON+ | <<missingFinalSemicolon>>

// class invariants, ghost and model fields, represents clauses and in clauses; a ghost declaration followed by a
// statement, such as "ghost int x; set x = 1;", is an in-method specification
private class_invariants ::= ((class_invariant | ghost_declaration | represents_clause | in_clause) AT_SIGN*)+
    !in_method_keyword
private in_method_keyword ::= set | assert | assume | maintaining | LOOPINVARIANT | decreases | decreasing
    | LOOP_DECREASES | LOOP_WRITES | LOOP_MODIFIES | LOOP_ASSIGNS | LOOP_ASSIGNABLE
    | check | show | reachable | unreachable | halt | split
// an invariant, or an initially clause, which holds after each constructor, or a history constraint, which relates the
// states before and after each method
class_invariant ::= modifiers? (invariant | initially | constraint) java_expr clause_end {pin="java_expr"}

// modifiers for methods and fields
modifiers ::= ((SPEC_PUBLIC | SPEC_PROTECTED | pure | instance | helper | nullable | NON_NULL | NULLABLE_BY_DEFAULT
    | NON_NULL_BY_DEFAULT | SPEC_PURE | math_modifier | java_modifier) SEMICOLON* AT_SIGN*)+
private math_modifier ::= CODE_JAVA_MATH | SPEC_JAVA_MATH | CODE_SAFE_MATH | SPEC_SAFE_MATH | CODE_BIGINT_MATH
    | SPEC_BIGINT_MATH
private java_modifier ::= public | private | protected | static | final

// specification inside a method
in_method_spec ::= (AT_SIGN* (loop_invariant | loop_variant | loop_assignable_clause | assert_statement | assume_statement
    | set_statement | ghost_declaration | check_statement | show_statement | reachable_statement | unreachable_statement
    | halt_statement | split_statement))+
loop_invariant ::= (maintaining | LOOPINVARIANT) java_expr clause_end {pin="java_expr"}
loop_variant ::= (decreases | decreasing | LOOP_DECREASES) java_expr clause_end {pin="java_expr"}
loop_assignable_clause ::= (LOOP_WRITES | LOOP_MODIFIES | LOOP_ASSIGNS | LOOP_ASSIGNABLE) <<skipAtSigns>> store_ref_list SEMICOLON+
// separate because in runtime checking they have different behaviours
assert_statement ::= assert java_expr clause_end {pin="java_expr"}
assume_statement ::= assume java_expr clause_end {pin="java_expr"}
// an assignment to a ghost variable, such as "set count = count + 1;"
set_statement ::= set java_expr SEMICOLON+ {pin="java_expr"}
// statements for OpenJML's static checking, with OpenJML's syntax: check is an assert that is not assumed afterwards,
// show lists expressions whose values OpenJML shows in a counterexample, reachable and unreachable check whether a
// statement can be reached, halt stops the checking of the rest of the path, and split splits the proof of the if,
// switch or loop after it; the ones without an expression need no semicolon at the end of the comment
check_statement ::= check java_expr clause_end {pin="java_expr"}
show_statement ::= show java_expr? SEMICOLON+ {pin=1}
reachable_statement ::= reachable SEMICOLON*
unreachable_statement ::= unreachable SEMICOLON*
halt_statement ::= halt SEMICOLON*
split_statement ::= split java_expr? SEMICOLON*

// a ghost field or local variable, such as "public ghost int count = 0;", with a type, a name and an optional initializer;
// or a model field, such as "public model int size;", whose value a represents clause gives
ghost_declaration ::= modifiers? (ghost | model) modifiers? <<parseGhostDeclarator>> SEMICOLON+ {pin=2}
// the value of a model field, such as "private represents size = count;", in which "<-" can replace "=", or a condition
// on it, as in "represents size \such_that size >= 0;"
represents_clause ::= modifiers? represents java_expr SEMICOLON+ {pin=2}
// the model fields whose data groups contain the field before it, such as "private int count; //@ in size;"
in_clause ::= in <<skipAtSigns>> store_ref (<<skipAtSigns>> COMMA <<skipAtSigns>> store_ref)* SEMICOLON+ {pin=1}


// store refs
private store_ref_list ::= store_ref_keyword | store_ref (<<skipAtSigns>> COMMA <<skipAtSigns>> store_ref)*
store_ref_keyword ::= NOTHING | EVERYTHING | NOT_SPECIFIED
store_ref ::= store_ref_name store_ref_name_suffix*
// the lexer gives an identifier for keywords that only start a clause, such as decreases, so they can be names
private store_ref_name ::= this | super | IDENT
// an array element can also be named with an index or a range of them, as in a[i] or a[0 .. n-1], as in OpenJML
private store_ref_name_suffix ::= (DOT this) | (DOT IDENT) | (DOT STAR)
    | (L_SQ_BRAC (STAR | array_index (DOT DOT array_index)?) R_SQ_BRAC)
private array_index ::= index_part+
private index_part ::= IDENT | REST | STAR | this | L_PAREN index_part* R_PAREN | DOT (IDENT | this)


// java reference to an exception class
reference_type ::= IDENT (DOT IDENT)*

// java expressions
java_expr ::= <<parseJavaExpression>>