{
  parserClass="nl.utwente.jmlplugin.parser.JMLParser"
  parserUtilClass="nl.utwente.jmlplugin.parser.JMLJavaParser"

  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix="JML"
  psiImplClassSuffix="Impl"
  psiPackage="nl.utwente.jmlplugin.psi"
  psiImplPackage="nl.utwente.jmlplugin.psi.impl"

  // JMLTypes extends the generated JMLGrammarTypes with the element and token types created by
  // JMLJavaParser and the lexers; use JMLTypes in code
  elementTypeHolderClass="nl.utwente.jmlplugin.psi.JMLGrammarTypes"
  elementTypeClass="nl.utwente.jmlplugin.psi.JMLElementType"
  tokenTypeClass="nl.utwente.jmlplugin.psi.JMLTokenType"
  // the factories give the types the readable names used in syntax error messages
  elementTypeFactory="nl.utwente.jmlplugin.psi.JMLElementType.create"
  tokenTypeFactory="nl.utwente.jmlplugin.psi.JMLTokenType.create"

  tokens = [
    SIGNALS_ONLY = 'signals_only'

    NOT_SPECIFIED = '\not_specified'
    NOTHING = '\nothing'
    EVERYTHING = '\everything'
    INTO = '\into'

    SPEC_PUBLIC = 'spec_public'
    SPEC_PROTECTED = 'spec_protected'
    NON_NULL = 'non_null'
    NULLABLE_BY_DEFAULT = 'nullable_by_default'
    NON_NULL_BY_DEFAULT = 'non_null_by_default'
    LOOPINVARIANT = 'loop_invariant'
    LOOP_DECREASES = 'loop_decreases'
    LOOP_WRITES = 'loop_writes'
    LOOP_MODIFIES = 'loop_modifies'
    LOOP_ASSIGNS = 'loop_assigns'
    LOOP_ASSIGNABLE = 'loop_assignable'
    // the lexer also gives these for the British spellings, such as normal_behaviour
    NORMAL_BEHAVIOR = 'normal_behavior'
    EXCEPTIONAL_BEHAVIOR = 'exceptional_behavior'
    BEHAVIOR = 'behavior'

    IDENT = "regexp:[_$a-zA-Z][_$a-zA-Z0-9]*"

    AT_SIGN = '@'
    SEMICOLON = ';'
    L_PAREN = '('
    R_PAREN = ')'
    DOT = '.'
    COMMA = ','
    COLON = ':'
    STAR = '*'
    L_SQ_BRAC ='['
    R_SQ_BRAC = ']'

    WHITE_SPACE = 'regexp:\s+'

    INFORMAL_DESCRIPTION = "regexp:\(\s*\*([^*]|\*+[^*)])+\*\s*\)"
    REST = "regexp:[^@;().,:*\[\]\s]"

  ]

  name("method_spec")="method specification"
  name("method_jml")="method specification"
  name("store_ref_list")="list of references"
  name("store_ref")="name"
  name("store_ref_keyword")="\\nothing, \\everything, \\not_specified"
  name("in_method_spec")="in-method specification"
  name("behavior_header")="behavior"
  name("loop_variant")="decreases clause"
  name("ghost_declaration")="ghost declaration"
  name("set_statement")="set statement"
  name("loop_assignable_clause")="loop_writes clause"
}

// root jml element
jml_root ::= jml_specification

jml_specification ::= AT_SIGN+ ((method_jml | class_invariants | modifiers | in_method_spec) AT_SIGN*)?

// specifications above methods; "also" can be on a line of its own, as in "//@ also"
method_jml ::= also? method_spec AT_SIGN* modifiers* | also
// a heavyweight specification case starts with a behavior, such as "public normal_behavior", also without "also"
// before it, as OpenJML allows
method_spec ::= spec_case (AT_SIGN* also spec_case | heavyweight_spec_case)*
private spec_case ::= heavyweight_spec_case | lightweight_spec_case
private heavyweight_spec_case ::= AT_SIGN* behavior_header lightweight_spec_case?
private lightweight_spec_case ::= requires_clause+ spec_body? | spec_body
behavior_header ::= (public | protected | private)? (NORMAL_BEHAVIOR | EXCEPTIONAL_BEHAVIOR | BEHAVIOR)
spec_body ::= (AT_SIGN* (ensures_clause | signals_clause | signals_only_clause | assignable_clause))+

// clauses allowed in method specifications
requires_clause ::= AT_SIGN* (requires|pre) pred_or_not SEMICOLON+ {pin="pred_or_not"}
ensures_clause ::= (ensures|post) pred_or_not SEMICOLON+ {pin="pred_or_not"}
signals_clause ::= signals L_PAREN reference_type IDENT? R_PAREN pred_or_not? SEMICOLON+ {pin="pred_or_not"}
// lists may continue on a new line that starts with @-signs, before or after a comma
signals_only_clause ::= SIGNALS_ONLY <<skipAtSigns>> reference_type (<<skipAtSigns>> COMMA <<skipAtSigns>> reference_type)* SEMICOLON+
assignable_clause ::= (assignable|modifiable|modifies) <<skipAtSigns>> store_ref_list SEMICOLON+
private pred_or_not ::= NOT_SPECIFIED | java_expr

// class invariants and ghost fields; a ghost declaration followed by a statement, such as "ghost int x; set x = 1;", is
// an in-method specification
private class_invariants ::= ((class_invariant | ghost_declaration) AT_SIGN*)+ !in_method_keyword
private in_method_keyword ::= set | assert | assume | maintaining | LOOPINVARIANT | decreases | decreasing
    | LOOP_DECREASES | LOOP_WRITES | LOOP_MODIFIES | LOOP_ASSIGNS | LOOP_ASSIGNABLE
class_invariant ::= modifiers? invariant java_expr SEMICOLON+ {pin="java_expr"}

// modifiers for methods and fields
modifiers ::= ((SPEC_PUBLIC | SPEC_PROTECTED | pure | instance | helper | nullable | NON_NULL | NULLABLE_BY_DEFAULT
    | NON_NULL_BY_DEFAULT | java_modifier) SEMICOLON* AT_SIGN*)+
private java_modifier ::= public | private | protected | static

// specification inside a method
in_method_spec ::= (AT_SIGN* (loop_invariant | loop_variant | loop_assignable_clause | assert_statement | assume_statement
    | set_statement | ghost_declaration))+
loop_invariant ::= (maintaining | LOOPINVARIANT) java_expr SEMICOLON+ {pin="java_expr"}
loop_variant ::= (decreases | decreasing | LOOP_DECREASES) java_expr SEMICOLON+ {pin="java_expr"}
loop_assignable_clause ::= (LOOP_WRITES | LOOP_MODIFIES | LOOP_ASSIGNS | LOOP_ASSIGNABLE) <<skipAtSigns>> store_ref_list SEMICOLON+
// separate because in runtime checking they have different behaviours
assert_statement ::= assert java_expr SEMICOLON+ {pin="java_expr"}
assume_statement ::= assume java_expr SEMICOLON+ {pin="java_expr"}
// an assignment to a ghost variable, such as "set count = count + 1;"
set_statement ::= set java_expr SEMICOLON+ {pin="java_expr"}

// a ghost field or local variable, such as "public ghost int count = 0;", with a type, a name and an optional initializer
ghost_declaration ::= modifiers? ghost modifiers? <<parseGhostDeclarator>> SEMICOLON+ {pin=2}


// store refs
private store_ref_list ::= store_ref_keyword | store_ref (<<skipAtSigns>> COMMA <<skipAtSigns>> store_ref)*
store_ref_keyword ::= NOTHING | EVERYTHING | NOT_SPECIFIED
store_ref ::= store_ref_name store_ref_name_suffix*
// the lexer gives an identifier for keywords that only start a clause, such as decreases, so they can be names
private store_ref_name ::= this | super | IDENT
private store_ref_name_suffix ::= (DOT this) | (DOT IDENT) | (DOT STAR) | (L_SQ_BRAC STAR R_SQ_BRAC)


// java reference to an exception class
reference_type ::= IDENT (DOT IDENT)*

// java expressions
java_expr ::= <<parseJavaExpression>>