<idea-plugin url="https://www.utwente.nl/">
    <name>IntelliJML</name>
    <id>nl.utwente.jmlplugin</id>
    <vendor url="https://www.utwente.nl/">University of Twente</vendor>

    <!-- Product and plugin compatibility requirements -->
    <!-- https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <!-- Run with JML Checks for Gradle run configurations, such as tests in Gradle projects -->
    <depends optional="true" config-file="intellijml-gradle.xml">com.intellij.gradle</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="JML File" implementationClass="nl.utwente.jmlplugin.JMLFileType"
                  fieldName="INSTANCE" language="JML" extensions="jml"/>
        <editorHighlighterProvider filetype="JML File"
                                   implementationClass="nl.utwente.jmlplugin.syntax_highlighting.JMLEditorHighlighterProvider"/>
        <lang.parserDefinition language="JML"
                               implementationClass="nl.utwente.jmlplugin.JMLParserDefinition"/>
        <lang.syntaxHighlighterFactory language="JML"
                                       implementationClass="nl.utwente.jmlplugin.syntax_highlighting.JMLSyntaxHighlighterFactory"/>
        <multiHostInjector implementation="nl.utwente.jmlplugin.JMLMultiHostInjector"/>
        <annotator language="JML"
                   implementationClass="nl.utwente.jmlplugin.annotator.JMLAnnotator"/>
        <annotator language="JML"
                   implementationClass="nl.utwente.jmlplugin.easteregg.Rainbow"/>
        <colorSettingsPage
                implementation="nl.utwente.jmlplugin.syntax_highlighting.JMLColorSettingsPage"/>
        <completion.contributor language="JML"
                                implementationClass="nl.utwente.jmlplugin.completion.JMLCompletionContributor"
                                order="first"/>
        <highlightErrorFilter implementation="nl.utwente.jmlplugin.annotator.JMLAnnotator"/>
        <!-- OpenJML's annotations in Java code, such as @NonNull -->
        <annotator language="JAVA" implementationClass="nl.utwente.jmlplugin.annotator.JMLJavaAnnotationAnnotator"/>
        <!-- the body of a pure method, which OpenJML only checks when it verifies the method -->
        <localInspection language="JAVA" shortName="JMLPureMethod" groupName="JML"
                         displayName="Pure method changes state" enabledByDefault="true" level="WARNING"
                         implementationClass="nl.utwente.jmlplugin.annotator.JMLPureMethodInspection"/>
        <!-- the body of a method with an assignable clause, which OpenJML only checks when it verifies the method -->
        <localInspection language="JAVA" shortName="JMLAssignable" groupName="JML"
                         displayName="Assignment not allowed by the assignable clause" enabledByDefault="true"
                         level="WARNING" implementationClass="nl.utwente.jmlplugin.annotator.JMLAssignableInspection"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/JMLDarculaColorScheme.xml"/>
        <additionalTextAttributes scheme="Default"
                                  file="colorSchemes/JMLDefaultLightColorScheme.xml"/>
        <applicationConfigurable groupId="tools" id="nl.utwente.jmlplugin.settings" displayName="IntelliJML"
                                 instance="nl.utwente.jmlplugin.settings.Configuration"/>
        <applicationService
                serviceImplementation="nl.utwente.jmlplugin.settings.JMLApplicationSettings"/>
        <!-- Run with JML Checks: run time checking by OpenJML -->
        <executor id="RunWithJMLChecks" implementation="nl.utwente.jmlplugin.rac.JMLRacExecutor"
                  order="after run"/>
        <programRunner implementation="nl.utwente.jmlplugin.rac.JMLRacProgramRunner"/>
        <consoleFilterProvider implementation="nl.utwente.jmlplugin.rac.JMLRacConsoleFilterProvider"/>
        <notificationGroup id="IntelliJML" displayType="BALLOON"/>
        <!-- Verify with OpenJML: static checking by OpenJML -->
        <externalAnnotator language="JAVA" implementationClass="nl.utwente.jmlplugin.esc.EscAnnotator"/>
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="nl.utwente.jmlplugin.esc.EscLineMarkerProvider"/>
        <editor.linePainter implementation="nl.utwente.jmlplugin.esc.EscValuesLinePainter"/>
        <completion.confidence language="JML"
                               implementationClass="nl.utwente.jmlplugin.completion.JMLCompletionConfidence"
                               id="asTrue" order="first"/>
        <defaultLiveTemplates file="/liveTemplates/JML.xml"/>
        <liveTemplateContext implementation="nl.utwente.jmlplugin.editor.templates.JMLContext"/>
        <!-- before IntelliJ's own Java import optimizer, which it uses: only one optimizer per language is used -->
        <lang.importOptimizer language="JAVA" implementationClass="nl.utwente.jmlplugin.editor.JMLImportOptimizer"
                              order="first"/>
        <!-- the names in JML for Find Usages, rename and Go to Declaration -->
        <referencesSearch implementation="nl.utwente.jmlplugin.editor.JMLReferencesSearcher"/>
        <methodReferencesSearch implementation="nl.utwente.jmlplugin.editor.JMLReferencesSearcher$Methods"/>
        <usageTypeProvider implementation="nl.utwente.jmlplugin.editor.JMLUsageTypeProvider"/>
        <useScopeEnlarger implementation="nl.utwente.jmlplugin.editor.JMLUseScopeEnlarger"/>
        <usageTargetProvider implementation="nl.utwente.jmlplugin.editor.JMLUsageTargetProvider"/>
        <!-- the steps of a counterexample of Verify; only there once there is one to step through -->
        <toolWindow id="JML Counterexample" anchor="bottom" icon="AllIcons.Toolwindows.ToolWindowDebugger"
                    factoryClass="nl.utwente.jmlplugin.esc.EscTraceView$Factory" doNotActivateOnStart="true"/>
        <renameHandler implementation="nl.utwente.jmlplugin.editor.JMLRenameHandler"/>
        <gotoDeclarationHandler implementation="nl.utwente.jmlplugin.editor.JMLGotoDeclarationHandler"/>
        <!-- Ctrl+/ in JML comments out the line of the Java file -->
        <lang.commenter language="JML" implementationClass="nl.utwente.jmlplugin.editor.JMLCommenter"/>
        <multiLangCommenter implementation="nl.utwente.jmlplugin.editor.JMLLineCommentProvider"/>
        <!-- imports that only JML uses are not greyed out as unused -->
        <daemon.highlightInfoFilter implementation="nl.utwente.jmlplugin.editor.JMLUnusedImportFilter"/>
        <!-- Reformat Code moves the lines of a JML block comment with its first line -->
        <preFormatProcessor implementation="nl.utwente.jmlplugin.editor.JMLBlockCommentIndent$Before"/>
        <postFormatProcessor implementation="nl.utwente.jmlplugin.editor.JMLBlockCommentIndent$After"/>
        <!-- nor fields, methods, parameters and variables that only JML uses -->
        <implicitUsageProvider implementation="nl.utwente.jmlplugin.editor.JMLImplicitUsageProvider"/>
        <!-- before Java's own handling of Enter in comments -->
        <enterHandlerDelegate implementation="nl.utwente.jmlplugin.editor.JMLEnterHandler" order="first"/>
        <lang.documentationProvider language="JAVA"
                                    implementationClass="nl.utwente.jmlplugin.documentation.JMLDocumentationProvider"
                                    order="first"/>
        <!-- Alt+Enter on a method without a specification -->
        <intentionAction>
            <language>JAVA</language>
            <className>nl.utwente.jmlplugin.annotator.AddSpecificationIntention</className>
            <category>JML</category>
        </intentionAction>
        <!-- Alt+Enter on a counting for loop without a loop specification -->
        <intentionAction>
            <language>JAVA</language>
            <className>nl.utwente.jmlplugin.annotator.AddLoopSpecificationIntention</className>
            <category>JML</category>
        </intentionAction>
        <!-- Alt+Enter on a JML clause whose condition is a conjunction -->
        <intentionAction>
            <language>JML</language>
            <className>nl.utwente.jmlplugin.annotator.SplitClauseIntention</className>
            <category>JML</category>
        </intentionAction>
        <!-- explanations of the JML keywords, on hover and with Ctrl+Q -->
        <lang.documentationProvider language="JML"
                                    implementationClass="nl.utwente.jmlplugin.documentation.JMLKeywordDocumentationProvider"/>
    </extensions>

    <projectListeners>
        <!-- decides which of OpenJML's messages outside proofs are shown, when the highlighting of a file is done -->
        <listener class="nl.utwente.jmlplugin.esc.EscDuplicates"
                  topic="com.intellij.codeInsight.daemon.DaemonCodeAnalyzer$DaemonListener"/>
    </projectListeners>

    <applicationListeners>
        <!-- checks the JML of a Java file with OpenJML when it is saved -->
        <listener class="nl.utwente.jmlplugin.esc.OpenJmlCheckOnSave"
                  topic="com.intellij.openapi.fileEditor.FileDocumentManagerListener"/>
    </applicationListeners>

    <actions>
        <group id="IntelliJML.Verify">
            <separator/>
            <action id="IntelliJML.VerifyMethod" class="nl.utwente.jmlplugin.esc.VerifyMethodAction"
                    text="Verify Method with OpenJML" icon="/Icons/verify.svg"
                    description="Lets OpenJML try to prove that the method at the caret meets its JML specification"/>
            <action id="IntelliJML.VerifyFile" class="nl.utwente.jmlplugin.esc.VerifyFileAction"
                    text="Verify File with OpenJML"
                    description="Lets OpenJML try to prove that the methods in the file meet their JML specifications"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="CodeMenu" anchor="last"/>
        </group>
        <reference ref="IntelliJML.VerifyFile">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </reference>
    </actions>
</idea-plugin>
